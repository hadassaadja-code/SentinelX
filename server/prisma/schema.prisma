// SentinelX - schéma de données
// Démo : SQLite. Production : remplacer provider par "postgresql" et url par env("DATABASE_URL").
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  createdAt    DateTime             @default(now())
  memberships  OrganizationMember[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String   @default("")
  ip        String   @default("")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  plan      String               @default("STARTER") // STARTER | PROFESSIONAL | BUSINESS
  createdAt DateTime             @default(now())
  members   OrganizationMember[]
  projects  Project[]
}

model OrganizationMember {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String // ADMIN | TECH_LEAD | ANALYST | READER

  @@unique([orgId, userId])
}

model Project {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  description  String        @default("")
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([orgId])
}

model Application {
  id              String    @id @default(cuid())
  orgId           String
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String    @default("")
  url             String
  type            String    @default("WEB") // WEB | API
  environment     String    @default("PRODUCTION") // DEVELOPMENT | STAGING | PRODUCTION
  authorized      Boolean   @default(false)
  authorizedAt    DateTime?
  authorizedBy    String?
  monitoring      Boolean   @default(false)
  monitorInterval Int       @default(60) // minutes
  lastStatus      String    @default("UNKNOWN") // UP | DOWN | UNKNOWN
  lastHttpCode    Int?
  lastResponseMs  Int?
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  scans           Scan[]
  incidents       Incident[]

  @@index([orgId])
}

model Scan {
  id            String              @id @default(cuid())
  orgId         String
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  modules       String // ex: "QA,SECURITY,PERFORMANCE"
  status        String              @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  error         String?
  score         Int?
  summary       String              @default("{}")
  createdById   String
  createdAt     DateTime            @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  findings      Finding[]
  testResults   TestResult[]
  metrics       PerformanceMetric[]

  @@index([orgId])
}

model Finding {
  id             String   @id @default(cuid())
  orgId          String
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  applicationId  String
  module         String
  title          String
  description    String
  severity       String // INFO | LOW | MEDIUM | HIGH | CRITICAL
  resource       String
  evidence       String
  recommendation String
  status         String   @default("DETECTED") // DETECTED | CONFIRMED | ASSIGNED | IN_PROGRESS | FIXED | RETESTED | CLOSED | FALSE_POSITIVE
  note           String   @default("")
  fingerprint    String
  createdAt      DateTime @default(now())

  @@index([orgId])
}

model TestResult {
  id         String @id @default(cuid())
  orgId      String
  scanId     String
  scan       Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name       String
  status     String // PASS | FAIL
  detail     String @default("")
  durationMs Int    @default(0)
}

model PerformanceMetric {
  id     String @id @default(cuid())
  orgId  String
  scanId String
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name   String
  value  Float
  unit   String
}

model Incident {
  id            String      @id @default(cuid())
  orgId         String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  status        String      @default("OPEN") // OPEN | RESOLVED
  occurrences   Int         @default(1)
  startedAt     DateTime    @default(now())
  resolvedAt    DateTime?

  @@index([orgId])
}

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  type      String
  title     String
  body      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orgId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  action    String
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([orgId])
}
